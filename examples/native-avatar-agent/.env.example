# Copy to .env and fill in. .env is git-ignored and never committed.
# Used only by README.md in this folder, to create the agent with the Kaltura APIs.
# The apps have their own .env, with WIDGET_ID and PARTNER_ID.

# Required: the Kaltura partner that owns the agent
PARTNER_ID=
# Required: the partner's admin secret. Never sent to an app or a browser.
# Do not paste the admin secret into chat; leave it here.
ADMIN_SECRET=
# Region of your partner: nvp1 is US production
REGION=nvp1
# Optional: Agentic API host. Required when REGION is not nvp1.
# US: https://api.avatar.us.kaltura.ai, EU: https://api.avatar.eu.kaltura.ai
AGENTIC_API_URL=
# Optional: Kaltura API host override
KALTURA_API_URL=
