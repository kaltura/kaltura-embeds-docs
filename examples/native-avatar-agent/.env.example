# Copy to .env and fill in. .env is git-ignored and never served.

# Required: widget (agent) ID and the Kaltura partner ID that owns it
WIDGET_ID=
PARTNER_ID=
# Only for agent/README.md (creates the agent with the Kaltura APIs).
# Never sent to the browser. Do not paste the admin secret into chat; leave it here.
ADMIN_SECRET=
# Region of your partner: nvp1 is US production
REGION=nvp1
