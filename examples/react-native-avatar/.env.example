# Copy to .env and fill in. .env is git-ignored and never served.

# Required: widget (agent) ID and the Kaltura partner ID that owns it
WIDGET_ID=
PARTNER_ID=

# Only for agent/README.md (creates the agent with the Kaltura APIs).
# Never sent to the browser. Do not paste it into chat; leave it here.
ADMIN_SECRET=

# Optional
PORT=4311
# Override for non-US regions
# KALTURA_API_URL=https://www.kaltura.com/api_v3
# AVATAR_API_URL=https://api.avatar.us.kaltura.ai
# GENIE_API_URL=https://genie.nvp1.ovp.kaltura.com   # agent setup only
